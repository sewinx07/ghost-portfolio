---
export const prerender = true;
import { getProject } from '@/data/projects';
import { PROJECTS } from '@/data/projects';
import Base from '@/layouts/Base.astro';

export async function getStaticPaths() {
  return PROJECTS.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = getProject(slug);

if (!project) {
  return Astro.redirect('/404');
}

const image = project.image ?? project.thumbnail;
---
<Base title={`${project.title} — SEWINX`} description={project.overview} image={image}>
  <main class="project">
    <header class="project__header">
      <p class="eyebrow mono">PROJECT</p>
      <h1 class="display">{project.title}</h1>
      <div class="project__meta mono">
        <span>{project.category}</span>
        <span>·</span>
        <span>{project.year}</span>
        <span>·</span>
        <span>{project.role}</span>
      </div>
    </header>

    <section class="project__section">
      <h2 class="mono">OVERVIEW</h2>
      <p>{project.overview}</p>
    </section>

    <section class="project__section">
      <h2 class="mono">PROCESS</h2>
      <p>{project.process}</p>
    </section>

    {project.features.length > 0 && (
      <section class="project__section">
        <h2 class="mono">KEY FEATURES</h2>
        <ul>
          {project.features.map((f) => <li>{f}</li>)}
        </ul>
      </section>
    )}

    <section class="project__section">
      <h2 class="mono">RESULT</h2>
      <p>{project.result}</p>
    </section>

    {project.technologies.length > 0 && (
      <section class="project__section">
        <h2 class="mono">TECHNOLOGIES</h2>
        <div class="tech">
          {project.technologies.map((t) => <span class="tech__item mono">{t}</span>)}
        </div>
      </section>
    )}

    {(project.link || project.source) && (
      <section class="project__links">
        {project.link && (
          <a class="btn btn--primary" href={project.link} target="_blank" rel="noopener" data-cursor="VISIT">
            LIVE PROJECT
          </a>
        )}
        {project.source && (
          <a class="btn btn--ghost" href={project.source} target="_blank" rel="noopener" data-cursor="CODE">
            SOURCE CODE
          </a>
        )}
      </section>
    )}
  </main>
</Base>

<style>
  .project {
    min-height: 100dvh;
    background: var(--ink);
    color: var(--mist);
    padding: clamp(4rem, 9vw, 8rem) var(--gutter) 6rem;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3rem);
    max-width: var(--max-w);
    margin: 0 auto;
  }
  .project__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: var(--bone);
    letter-spacing: 0.06em;
  }
  .project__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--mist-dim);
  }
  .project__section {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    max-width: 68ch;
  }
  .project__section h2 {
    font-size: 0.68rem;
    letter-spacing: 0.34em;
    color: var(--red-bright);
  }
  .project__section p {
    line-height: 1.9;
  }
  .project__section ul {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-left: 1.2rem;
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .tech__item {
    padding: 0.45rem 0.8rem;
    border: 1px solid rgba(207, 196, 178, 0.28);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: transform 0.2s, background 0.2s, color 0.2s, border-color 0.2s;
  }
  .btn--primary {
    background: var(--red);
    color: #fff;
  }
  .btn--primary:hover {
    background: var(--red-bright);
    transform: translateY(-2px);
  }
  .btn--ghost {
    border: 1px solid rgba(207, 196, 178, 0.4);
    color: var(--bone);
  }
  .btn--ghost:hover {
    border-color: var(--bone);
    background: rgba(207, 196, 178, 0.08);
  }
</style>
