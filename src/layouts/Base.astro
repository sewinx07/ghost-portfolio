---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'SEWINX — Creative Developer & Designer',
  description =
    'Enter the world of Taha Gmir (SEWINX) — a cinematic interactive portfolio blending code, design and motion.',
  image = '/assets/characters/taha-home.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://sewinx.dev');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site).toString()} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:site_name" content="SEWINX" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site).toString()} />

    <meta name="theme-color" content="#0b0806" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Mark reduced motion early to avoid a flash of animation.
      try {
        if (window.matchMedia('(pointer: coarse)').matches) {
          document.documentElement.classList.add('is-touch');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
