---
import '../animations/utils';
---

<section class="boot" aria-label="System boot" data-boot-root>
  <div class="boot__inner">
    <p class="boot__brand display">SEWINX</p>
    <p class="boot__status mono" data-boot-line>INITIALIZING ...</p>
    <div class="boot__track" role="progressbar" aria-label="Loading">
      <div class="boot__bar" data-boot-bar></div>
    </div>
    <p class="boot__pct mono" data-boot-pct>000%</p>
    <button class="boot__skip mono" data-boot-skip>SKIP INTRO</button>
  </div>
</section>

<style>
  .boot {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #000;
    display: grid;
    place-items: center;
  }
  .boot--done {
    pointer-events: none;
  }
  .boot__inner {
    text-align: center;
    width: min(34rem, 84vw);
    padding: 2rem;
  }
  .boot__brand {
    font-size: clamp(2.4rem, 6vw, 4rem);
    letter-spacing: 0.3em;
    color: var(--bone);
    margin-bottom: 2rem;
  }
  .boot__brand::after {
    content: '';
    display: block;
    width: 5.5rem;
    height: 2px;
    margin: 1rem auto 0;
    background: var(--red);
  }
  .boot__status {
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    color: var(--mist-dim);
    min-height: 1.4em;
  }
  .boot__track {
    margin: 2rem auto 1rem;
    width: 100%;
    height: 3px;
    background: #241c14;
    overflow: hidden;
  }
  .boot__bar {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--red), var(--red-bright));
    transition: width 0.2s;
  }
  .boot__pct {
    font-size: 0.9rem;
    color: var(--mist-dim);
    letter-spacing: 0.2em;
  }
  .boot__skip {
    margin-top: 2.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    color: var(--mist-dim);
    padding: 0.6rem 1.4rem;
    border: 1px solid #3a2f22;
    transition:
      color 0.3s,
      border-color 0.3s;
  }
  .boot__skip:hover {
    color: var(--red-bright);
    border-color: var(--red);
  }
</style>
