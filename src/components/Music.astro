---
/** Cinematic background music toggle.
 *  Loops "The Way of the Ghost" (Ghost of Tsushima).
 *  Place the file at: public/assets/music/the-way-of-the-ghost.mp3
 *  The toggle only appears once the audio is ready, so a missing
 *  file never leaves a broken control. */
const SRC = '/assets/music/the-way-of-the-ghost.mp3';
---

<div class="music" data-music-root hidden>
  <audio class="music__audio" src={SRC} data-music loop preload="auto"></audio>
  <button
    type="button"
    class="music__btn"
    data-music-btn
    aria-pressed="false"
    aria-label="Play background music"
  >
    <span class="music__bars" aria-hidden="true">
      <i></i><i></i><i></i>
    </span>
    <span class="music__label mono" data-music-label>MUSIC</span>
  </button>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-music-root]');
  const btn = document.querySelector<HTMLButtonElement>('[data-music-btn]');
  const audio = document.querySelector<HTMLAudioElement>('[data-music]');
  const label = document.querySelector<HTMLElement>('[data-music-label]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!root || !btn || !audio || !label) {
    // bail out safely if the DOM shape ever changes
    if (root) root.hidden = true;
  } else {
    let ready = false;
    let playing = false;
    let started = false;

    const showWhen = (v: boolean) => {
      root.hidden = !v;
    };

    // Only reveal the toggle once the audio file actually exists/loads.
    audio.addEventListener('loadedmetadata', () => {
      ready = true;
      showWhen(true);
    });
    audio.addEventListener('error', () => {
      // Missing/unplayable file: keep the control hidden.
      ready = false;
      showWhen(false);
    });

    const start = () => {
      if (started) return;
      started = true;
      // Music waits until the boot veil is gone. If the user's first gesture
      // lands during the boot screen, poll briefly for it to finish.
      const tryPlay = () => {
        if (document.querySelector('[data-boot-root]')) {
          if (waitTries++ < 100) window.setTimeout(tryPlay, 120);
        } else {
          attemptPlay();
        }
      };
      tryPlay();
    };

    let waitTries = 0;

    const attemptPlay = () => {
      if (!ready) return;
      audio.play().then(() => {
        playing = true;
        update();
      }).catch(() => {
        playing = false;
      });
    };

    const toggle = () => {
      if (!ready) return;
      if (audio.paused) {
        audio.play().then(() => {
          playing = true;
          update();
        }).catch(() => {});
      } else {
        audio.pause();
        playing = false;
        update();
      }
    };

    const update = () => {
      btn.setAttribute('aria-pressed', String(playing));
      btn.classList.toggle('is-playing', playing);
      btn.setAttribute('aria-label', playing ? 'Pause background music' : 'Play background music');
    };

    // Autoplay after the first user gesture, once boot has finished.
    const gesture = () => start();
    window.addEventListener('click', gesture, { once: false });
    window.addEventListener('keydown', gesture, { once: false });

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      started = true;
      toggle();
    });

    // Cleanup
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('click', gesture);
      window.removeEventListener('keydown', gesture);
    });
  }
</script>

<style>
  .music {
    position: fixed;
    top: 1.5rem;
    right: var(--gutter);
    transform: translateY(1.6rem);
    z-index: 70;
    display: flex;
    justify-content: flex-end;
  }
  .music__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.7rem 0.45rem 0.85rem;
    background: rgba(11, 8, 6, 0.42);
    border: 1px solid rgba(201, 196, 178, 0.18);
    border-radius: 2px;
    color: var(--mist);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.6s var(--ease-cinematic), color 0.3s ease,
      border-color 0.3s ease, background 0.3s ease;
    font-variant-numeric: tabular-nums;
  }
  .music:not([hidden]) .music__btn {
    opacity: 1;
    animation: music-in 0.8s var(--ease-cinematic) 0.2s both;
  }
  .music__btn:hover {
    color: var(--bone);
    border-color: rgba(201, 196, 178, 0.4);
  }
  .music__label {
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    color: inherit;
  }
  /* Animated equalizer bars: silent (muted) vs playing */
  .music__bars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 12px;
    width: 12px;
  }
  .music__bars i {
    display: block;
    width: 2px;
    height: 4px;
    background: var(--mist-dim);
    transition: background 0.3s ease, height 0.3s ease;
  }
  .music__btn.is-playing .music__bars i {
    background: var(--red-bright);
    animation: eq 1.2s ease-in-out infinite;
  }
  .music__btn.is-playing .music__bars i:nth-child(2) { animation-delay: 0.2s; }
  .music__btn.is-playing .music__bars i:nth-child(3) { animation-delay: 0.4s; }
  @keyframes eq {
    0%, 100% { height: 4px; }
    50% { height: 11px; }
  }
  @keyframes music-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .music__btn.is-playing .music__bars i,
    .music:not([hidden]) .music__btn {
      animation: none;
    }
  }
  @media (max-width: 720px) {
    .music {
      top: auto;
      bottom: 1.4rem;
      right: 1rem;
    }
  }
</style>
