---
import { EXPERIENCE } from '../data/experience';
---

<div class="experience section-content">
  <p class="eyebrow" data-fade-in>MISSION LOG</p>
  <h2 class="display section-title" data-fade-in>The Journey</h2>

  <ol class="timeline">
    {EXPERIENCE.map((e, i) => (
      <li class="timeline__item" data-fade-in>
        <div class="timeline__marker" aria-hidden="true"></div>
        <div class="timeline__year mono">{e.year}</div>
        <div>
          <h3 class="timeline__role">{e.role}</h3>
          {e.place && <p class="timeline__place mono">{e.place}</p>}
          <p class="timeline__desc">{e.description}</p>
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .section-content {
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    opacity: 0;
  }
  .section-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    color: var(--bone);
  }
  .timeline {
    list-style: none;
    position: relative;
    padding-left: 2rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(rgba(192, 57, 43, 0.6), rgba(207, 196, 178, 0.15));
  }
  .timeline__item {
    position: relative;
    padding: 0.4rem 0 2rem 0.5rem;
  }
  .timeline__marker {
    position: absolute;
    left: -1.7rem;
    top: 0.9rem;
    width: 13px;
    height: 13px;
    border: 2px solid var(--red);
    background: var(--ink);
    transform: rotate(45deg);
  }
  .timeline__year {
    font-size: 0.72rem;
    letter-spacing: 0.3em;
    color: var(--red-bright);
  }
  .timeline__role {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--bone);
    margin: 0.2rem 0 0.3rem;
  }
  .timeline__place {
    font-size: 0.7rem;
    color: var(--mist-dim);
    margin-bottom: 0.5rem;
  }
  .timeline__desc {
    color: var(--mist);
    font-size: 0.95rem;
    max-width: 34rem;
  }
</style>
