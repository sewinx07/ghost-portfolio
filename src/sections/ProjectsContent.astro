---
import { PROJECTS } from '../data/projects';
---

<div class="projects section-content">
  <p class="eyebrow" data-fade-in>PROJECT DATABASE</p>
  <h2 class="display section-title" data-fade-in>The Forge</h2>

  <ul class="project-grid" data-fade-in>
    {PROJECTS.map((p, i) => (
      <li>
        <a class="project-card" href={`/projects/${p.slug}`} data-cursor="OPEN">
          <span class="project-card__num mono">{String(i + 1).padStart(2, '0')}</span>
          <div class="project-card__body">
            <h3 class="project-card__title display">{p.title}</h3>
            <p class="project-card__cat mono">{p.category}</p>
          </div>
          <span class="project-card__arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="projects__note mono" data-fade-in>
    MORE PROJECTS LOADING · THE FORGE IS ALWAYS FORGING
  </p>
</div>

<style>
  .section-content {
    max-width: 42rem;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    opacity: 0;
  }
  .section-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    color: var(--bone);
  }
  .project-grid {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .project-card {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1.3rem 1.4rem;
    background: rgba(8, 6, 4, 0.55);
    border: 1px solid rgba(207, 196, 178, 0.14);
    border-left: 3px solid transparent;
    backdrop-filter: blur(4px);
    transition:
      border-color 0.25s,
      transform 0.25s,
      background 0.25s;
  }
  .project-card:hover {
    border-color: rgba(192, 57, 43, 0.6);
    border-left-color: var(--red);
    transform: translateX(8px);
    background: rgba(12, 8, 5, 0.75);
  }
  .project-card__num {
    color: var(--red-bright);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
  }
  .project-card__title {
    font-size: 1.6rem;
    color: var(--bone);
    line-height: 1.1;
  }
  .project-card__cat {
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    color: var(--mist-dim);
    margin-top: 0.3rem;
  }
  .project-card__arrow {
    margin-left: auto;
    font-size: 1.4rem;
    color: var(--mist-dim);
    transition: color 0.2s, transform 0.2s;
  }
  .project-card:hover .project-card__arrow {
    color: var(--red-bright);
    transform: translateX(4px);
  }
  .projects__note {
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    color: var(--mist-dim);
  }
</style>
